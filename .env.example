# Copie este arquivo para ".env" e preencha com valores reais.
# ".env" nunca é commitado (veja .gitignore).
# Este arquivo (.env.example) mostra só os NOMES das variáveis — nunca valores reais.

# --- Exemplo: integração genérica de CRM/task manager ---
# CLICKUP_API_TOKEN=

# --- Exemplo: WordPress / site próprio ---
# WP_URL=
# WP_USER=
# WP_PASS=

# --- Exemplo: Google Ads ---
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_APPLICATION_CREDENTIALS=       # caminho local pro arquivo de credencial, NUNCA o conteúdo aqui
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Exemplo: Make/n8n ---
# MAKE_API_TOKEN=
# N8N_API_TOKEN=

# --- Exemplo: Meta / WhatsApp (Z-API) ---
# META_ACCESS_TOKEN=
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=

# --- Exemplo: banco de dados (Supabase, Postgres) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Adicione as suas conforme os MCPs/integrações que habilitar
# (veja MANIFESTO-FERRAMENTAS.md).
